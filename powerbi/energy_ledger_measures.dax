Invoice Cost INR = SUM ( Fact Energy Ledger[invoice_amount_local] )
Energy kWh = SUM ( Fact Energy Ledger[quantity_kwh_equivalent] )
Emissions tCO2e = DIVIDE ( SUM ( Fact Energy Ledger[emissions_kgco2e] ), 1000 )
Cost per kWh = DIVIDE ( [Invoice Cost INR], [Energy kWh] )
Energy Intensity kWh per sqm = DIVIDE ( [Energy kWh], SUM ( Dim Site[floor_area_sqm] ) )
Prior Month Energy kWh = CALCULATE ( [Energy kWh], DATEADD ( 'Dim Date'[Date], -1, MONTH ) )
Energy MoM % = DIVIDE ( [Energy kWh] - [Prior Month Energy kWh], [Prior Month Energy kWh] )
Bill Meter Variance % = AVERAGE ( Bill Meter Variance[bill_vs_meter_variance_pct] )
High Variance Count = CALCULATE ( COUNTROWS ( Bill Meter Variance ), Bill Meter Variance[reconciliation_status] = "variance_high" )
High Anomaly Count = CALCULATE ( COUNTROWS ( Meter Anomaly ), Meter Anomaly[anomaly_status] IN { "anomaly_high", "anomaly_low" } )
DQ Reconciliation Pass Count = CALCULATE ( COUNTROWS ( Reconciliation ), Reconciliation[reconciliation_status] = "PASS" )
Invoice Cost by Invoice Date = CALCULATE ( [Invoice Cost INR], USERELATIONSHIP ( 'Dim Date'[Date], Fact Energy Ledger[invoice_date] ) )
Invoice Cost by Billing Start = CALCULATE ( [Invoice Cost INR], USERELATIONSHIP ( 'Dim Date'[Date], Fact Energy Ledger[billing_start_date] ) )
